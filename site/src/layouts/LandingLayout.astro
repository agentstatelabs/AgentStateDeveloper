---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Code-level context and audit overlay for agent-authored code. Decision ledger, effect declarations, call graph, policy gate, and an append-only audit stream — overlaying git, not replacing it.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content="https://agentstatedeveloper.dev/og-image.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={Astro.url.href} />
	</head>
	<body class="landing">
		<nav class="top-nav">
			<div class="container nav-inner">
				<a href="/" class="brand">
					<span class="dot"></span>
					<span class="brand-text">AgentStateDeveloper</span>
					<span class="brand-suffix">· asd</span>
				</a>
				<div class="nav-links">
					<a href="/guides/introduction">Docs</a>
					<a href="/reference/cli">CLI</a>
					<a href="/reference/mcp-tools">MCP</a>
					<a href="/guides/ecosystem">Ecosystem</a>
					<a
						href="https://github.com/agentstatelabs/AgentStateDeveloper"
						rel="noopener"
						class="nav-gh"
					>
						GitHub
					</a>
				</div>
			</div>
		</nav>

		<main>
			<slot />
		</main>

		<SiteFooter />
	</body>
</html>

<style>
	.top-nav {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--asd-border-lo);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #ffffff !important;
		font-family: var(--asd-font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
	}

	.brand:hover {
		text-decoration: none;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 2px;
		background: var(--asd-accent);
		box-shadow: 0 0 10px rgba(249, 115, 22, 0.5);
	}

	.brand-suffix {
		color: var(--asd-text-dim);
		font-weight: 400;
	}

	.nav-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.nav-links a {
		color: var(--asd-text-dim);
		font-size: 0.9rem;
		font-weight: 500;
	}

	.nav-links a:hover {
		color: #ffffff;
		text-decoration: none;
	}

	.nav-gh {
		padding: 0.35rem 0.85rem;
		border: 1px solid var(--asd-border-hi);
		border-radius: var(--asd-radius-md);
	}

	@media (max-width: 640px) {
		.nav-links {
			gap: 0.9rem;
		}
		.nav-links a:not(.nav-gh) {
			display: none;
		}
		.brand-suffix {
			display: none;
		}
	}
</style>
