---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container footer-grid">
		<div class="col-brand">
			<div class="wordmark">AgentStateDeveloper</div>
			<p class="tag">The audit layer for agent-authored code.</p>
		</div>

		<div class="col-links">
			<h4>Docs</h4>
			<ul>
				<li><a href="/guides/introduction">Introduction</a></li>
				<li><a href="/guides/quickstart">Quickstart</a></li>
				<li><a href="/guides/architecture">Architecture</a></li>
				<li><a href="/guides/ecosystem">Ecosystem</a></li>
				<li><a href="/reference/cli">CLI reference</a></li>
			</ul>
		</div>

		<div class="col-links">
			<h4>Reference</h4>
			<ul>
				<li><a href="/reference/mcp-tools">MCP tools</a></li>
				<li><a href="/reference/http-api">HTTP API</a></li>
				<li><a href="/reference/policy-schema">Policy schema</a></li>
				<li><a href="/reference/audit-schema">Audit event schema</a></li>
			</ul>
		</div>

		<div class="col-links">
			<h4>Project</h4>
			<ul>
				<li>
					<a href="https://github.com/agentstatelabs/AgentStateDeveloper" rel="noopener">GitHub</a>
				</li>
				<li>
					<a href="https://github.com/agentstatelabs/AgentStateDeveloper/releases" rel="noopener">Releases</a>
				</li>
				<li>
					<a href="https://github.com/agentstatelabs/AgentStateDeveloper/issues" rel="noopener">Report an issue</a>
				</li>
				<li><a href="/guides/ecosystem">Ecosystem</a></li>
			</ul>
		</div>
	</div>

	<div class="container footer-base">
		<div class="copyright">
			© {year} AgentStateLabs, LLC. Source-available (BSL-1.1 → Apache-2.0 after 4 years).
		</div>
		<div class="built-on">
			Built on
			<a href="https://agentstategraph.dev" rel="noopener">AgentStateGraph</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: #050505;
		border-top: 1px solid var(--asd-border);
		padding: 3rem 0 1.5rem 0;
		color: var(--asd-text-dim);
		font-size: 0.85rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 2rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--asd-border-lo);
	}

	.col-brand .wordmark {
		color: var(--asd-accent);
		font-family: var(--asd-font-mono);
		font-weight: 800;
		font-size: 1rem;
		margin-bottom: 0.35rem;
	}

	.col-brand .tag {
		color: var(--asd-text-dim);
		margin: 0;
		max-width: 18rem;
		font-size: 0.82rem;
	}

	.col-links h4 {
		color: #ffffff;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0 0 0.75rem 0;
		font-weight: 600;
	}

	.col-links ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.col-links li {
		margin-bottom: 0.4rem;
	}

	.col-links a {
		color: var(--asd-text-dim);
	}

	.col-links a:hover {
		color: var(--asd-text);
		text-decoration: none;
	}

	.footer-base {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1.5rem;
		font-size: 0.75rem;
		color: var(--asd-text-faint);
		flex-wrap: wrap;
		gap: 1rem;
	}

	.footer-base a {
		color: var(--asd-text-dim);
	}

	@media (max-width: 820px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 520px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
