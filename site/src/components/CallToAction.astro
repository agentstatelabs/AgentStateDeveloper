---
/**
 * Final CTA — repeats the two key install paths so users who
 * read to the bottom don't have to scroll back up.
 */
---

<section class="section cta-section">
	<div class="container">
		<h2>Close the audit gap. Today.</h2>
		<p class="lede">
			No signup. No server to rent. No SaaS bill. A Rust binary that
			runs on your laptop, stores everything in a local ASG repo under
			<code>.asd-state.db</code>, and travels in your git tree via
			<code>.asd/</code> sidecar.
		</p>

		<div class="install-options">
			<code class="install-cmd">cargo install asd</code>
			<span class="sep">·</span>
			<code class="install-cmd">asd init &amp;&amp; asd index .</code>
		</div>

		<div class="links">
			<a class="btn btn-primary" href="/guides/quickstart">
				5-minute quickstart →
			</a>
			<a
				class="btn btn-secondary"
				href="https://github.com/agentstatelabs/AgentStateDeveloper"
				rel="noopener"
			>
				Star on GitHub
			</a>
		</div>
		<p class="license-note">
			Source-available under BSL-1.1. Every release converts to Apache-2.0
			four years after it ships.
		</p>
	</div>
</section>

<style>
	.cta-section {
		padding: 5rem 0;
		background:
			radial-gradient(
				ellipse at bottom,
				rgba(249, 115, 22, 0.06),
				transparent 60%
			),
			var(--asd-bg);
		text-align: center;
		border-bottom: none;
	}

	.cta-section .container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.75rem 0;
		letter-spacing: -0.01em;
	}

	.lede {
		color: var(--asd-text-dim);
		font-size: 1rem;
		max-width: 38rem;
		margin: 0 0 2rem 0;
		line-height: 1.65;
	}

	.lede code {
		background: var(--asd-panel);
		border: 1px solid var(--asd-border);
		padding: 0.1rem 0.4rem;
		border-radius: var(--asd-radius-sm);
		font-size: 0.9em;
		color: var(--asd-accent-text);
		font-family: var(--asd-font-mono);
	}

	.install-options {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.75rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.install-cmd {
		display: inline-block;
		background: var(--asd-panel);
		border: 1px solid var(--asd-border-hi);
		border-radius: var(--asd-radius-md);
		padding: 0.5rem 1rem;
		font-family: var(--asd-font-mono);
		font-size: 0.85rem;
		color: var(--asd-accent-text);
	}

	.sep {
		color: var(--asd-text-faint);
	}

	.links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.license-note {
		margin-top: 2rem;
		color: var(--asd-text-faint);
		font-size: 0.8rem;
	}
</style>
