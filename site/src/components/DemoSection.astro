---
/**
 * "How it feels" — four CLI exchanges showing the full loop.
 * Pre content lives in frontmatter so raw { } in JSON strings don't
 * trip Astro's template parser. set:html renders it verbatim.
 */
const demoHtml = [
  '<span class="c"># 1. Index — parses symbols, infers effects, builds the call graph.</span>',
  '<span class="p">$</span> asd init &amp;&amp; asd index .',
  '<span class="out">{"files": 4, "symbols": 16, "edges": 8,',
  ' "intra_module_edges": 5, "cross_module_edges": 3,',
  ' "effects": 16, "transitive_updates": 1}</span>',
  '',
  '<span class="c"># 2. Read — declared + transitive effects, call graph neighbours, ledger.</span>',
  '<span class="p">$</span> asd read payments.chargeCard',
  '<span class="json">{',
  '  "symbol": {"qname": "payments.chargeCard", "file": "src/payments.py", ...},',
  '  "effects": {',
  '    "declared": ["io.net.out", "io.db.write"],',
  '    "transitive": [',
  '      {"effect": "io.fs.write", "via": ["logger.writeLog"]},',
  '      {"effect": "log",         "via": ["logger.writeLog"]},',
  '      {"effect": "throw",       "via": ["payments.chargeCard"]}',
  '    ]',
  '  },',
  '  "ledger": []',
  '}</span>',
  '',
  '<span class="c"># 3. Append a hazard under policy — lands awaiting-approval, audit event emitted.</span>',
  '<span class="p">$</span> asd --policy policies.json --audit-log audit.jsonl \\',
  '     ledger append payments.chargeCard \\',
  '     --kind hazard --summary "fails on amounts &gt;10k" \\',
  '     --author-id alice --author-kind human',
  '<span class="warn">{"status": "awaiting-approval",',
  ' "entry_id": "led_d4b...",',
  ' "matched_policy": "/policies/code/hazard-requires-human@1"}</span>',
  '',
  '<span class="c"># 4. Tail the audit log — every action, deny, and approval, in order.</span>',
  '<span class="p">$</span> asd audit tail --event-type ledger --limit 3',
  '<span class="out">ledger.append   awaiting-approval   actor=alice   policy=/policies/code/hazard-requires-human@1',
  'ledger.approve  approved            actor=alice   policy=/policies/code/hazard-requires-human@1',
  'ledger.append   denied              actor=bot-1   policy=/policies/code/no-tradeoffs-without-body@1</span>',
].join('\n');
---

<section class="section demo">
	<div class="container">
		<div class="eyebrow">
			<span class="eyebrow-text">HOW_IT_FEELS //</span>
		</div>
		<h2 class="section-title">Three commands on a real repo.</h2>
		<p class="section-lede">
			CLI-first for scripting, MCP for agent consumption, HTTP for
			dashboards. All three surfaces share the same policy gate,
			the same audit stream, the same ledger semantics.
		</p>

		<div class="demo-wrap">
			<pre class="demo" set:html={demoHtml}></pre>
		</div>
	</div>
</section>

<style>
	.demo {
		padding: 5rem 0;
	}

	.eyebrow {
		font-family: var(--asd-font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: var(--asd-accent-text);
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.demo-wrap {
		margin-top: 2rem;
	}

	pre.demo {
		background: #050505;
		border: 1px solid var(--asd-border);
		border-radius: var(--asd-radius-lg);
		padding: 1.5rem 1.75rem;
		overflow-x: auto;
		font-size: 0.82rem;
		line-height: 1.65;
		font-family: var(--asd-font-mono);
		color: var(--asd-text);
	}

	pre.demo :global(.c)    { color: var(--asd-text-faint); }
	pre.demo :global(.p)    { color: var(--asd-accent); font-weight: 700; }
	pre.demo :global(.out)  { color: var(--asd-success); }
	pre.demo :global(.warn) { color: var(--asd-warn); }
	pre.demo :global(.json) { color: var(--asd-text-code); }
</style>
