# frozen_string_literal: true

# AgentStateDeveloper (ASD) Homebrew formula template.
#
# Plan N t-001 (1.1.14): the release workflow renders this template for
# each tag by substituting:
#
#   {{VERSION}}               — release version without leading 'v' (e.g. "1.1.14")
#   {{TAG}}                   — release tag including 'v' (e.g. "v1.1.14")
#   {{URL_DARWIN_ARM64}}      — macOS arm64 tarball URL
#   {{SHA_DARWIN_ARM64}}      — macOS arm64 tarball sha256
#   {{URL_DARWIN_X86_64}}     — macOS x86_64 tarball URL
#   {{SHA_DARWIN_X86_64}}     — macOS x86_64 tarball sha256
#   {{URL_LINUX_X86_64}}      — Linux x86_64 tarball URL
#   {{SHA_LINUX_X86_64}}      — Linux x86_64 tarball sha256
#   {{URL_LINUX_ARM64}}       — Linux arm64 tarball URL
#   {{SHA_LINUX_ARM64}}       — Linux arm64 tarball sha256
#
# The rendered output goes to:
#   agentstatelabs/homebrew-agentstatedeveloper/Formula/asd.rb

class Asd < Formula
  desc "AgentStateDeveloper — semantic state layer + read API for AI agents on code"
  homepage "https://github.com/agentstatelabs/agentstatedeveloper"
  version "{{VERSION}}"
  license "BSL-1.1"

  on_macos do
    on_arm do
      url "{{URL_DARWIN_ARM64}}"
      sha256 "{{SHA_DARWIN_ARM64}}"
    end
    on_intel do
      url "{{URL_DARWIN_X86_64}}"
      sha256 "{{SHA_DARWIN_X86_64}}"
    end
  end

  on_linux do
    on_intel do
      url "{{URL_LINUX_X86_64}}"
      sha256 "{{SHA_LINUX_X86_64}}"
    end
    on_arm do
      url "{{URL_LINUX_ARM64}}"
      sha256 "{{SHA_LINUX_ARM64}}"
    end
  end

  def install
    bin.install "asd"
    bin.install "asd-mcp"
    bin.install "asd-serve"
  end

  def caveats
    <<~EOS
      AgentStateDeveloper is installed. Next steps:

        cd <your-project>
        asd init                  # one-time setup + git hooks
        asd index .               # index the codebase
        asd repo add --activate   # register with the shared registry

      Then any tool wired to `asd-mcp` (Claude Desktop, Claude Code, Codex)
      will see this repo as its active context.

      Docs: https://github.com/agentstatelabs/agentstatedeveloper
    EOS
  end

  test do
    assert_match "asd", shell_output("#{bin}/asd --version")
  end
end
